<style>

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: #f5f7fb;
    color: #0f172a;
    font-family: Inter, system-ui, sans-serif;
}

button,
input,
textarea,
select {
    font-family: inherit;
}

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: #f1f5f9;
}

::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 20px;
}


/* =====================================================
   CONTROL VISUAL DE SESIÓN
===================================================== */

/*
   Por defecto:
   - Login visible
   - App oculta

   Si existe sesión:
   - Login oculto
   - App visible

   Esto ocurre ANTES de que la página termine de cargar,
   evitando el flash del login.
*/

#loginScreen {
    display: flex;
}

#app {
    display: none;
}

html.saders-session #loginScreen {
    display: none !important;
}

html.saders-session #app {
    display: block !important;
}


/* =====================================================
   LOGIN
===================================================== */

#loginScreen {

    min-height: 100vh;

    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(37,99,235,.13),
            transparent 30%
        ),
        radial-gradient(
            circle at 85% 80%,
            rgba(6,182,212,.10),
            transparent 30%
        ),
        #f8fafc;

}

.login-grid {

    background-image:
        linear-gradient(
            rgba(148,163,184,.045) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(148,163,184,.045) 1px,
            transparent 1px
        );

    background-size: 35px 35px;

}


/* =====================================================
   LOGO
===================================================== */

.logo-box {

    width: 46px;
    height: 46px;

    border-radius: 14px;

    background: #0f172a;

    display: flex;
    align-items: center;
    justify-content: center;

}


/* =====================================================
   APP
===================================================== */

.sidebar {

    width: 255px;

    position: fixed;

    left: 0;
    top: 0;
    bottom: 0;

    background: white;

    border-right: 1px solid #e7ebf1;

    z-index: 50;

}

.main {

    margin-left: 255px;

    min-height: 100vh;

}


/* =====================================================
   NAVIGATION
===================================================== */

.nav-item {

    width: 100%;

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 12px 14px;

    border-radius: 13px;

    color: #64748b;

    font-size: 13px;

    font-weight: 800;

    transition: .2s;

    cursor: pointer;

    text-align: left;

}

.nav-item:hover {

    background: #f1f5f9;

    color: #0f172a;

}

.nav-item.active {

    background: #eff6ff;

    color: #2563eb;

}

.nav-icon {

    width: 19px;
    height: 19px;

}


/* =====================================================
   TOPBAR
===================================================== */

.topbar {

    height: 68px;

    background: rgba(255,255,255,.94);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid #e7ebf1;

    position: sticky;

    top: 0;

    z-index: 40;

}


/* =====================================================
   CARDS
===================================================== */

.card {

    background: white;

    border: 1px solid #e7ebf1;

    border-radius: 20px;

    box-shadow:
        0 8px 30px rgba(15,23,42,.035);

}

.card-hover {

    transition: .2s;

}

.card-hover:hover {

    transform: translateY(-2px);

    box-shadow:
        0 18px 45px rgba(15,23,42,.07);

}


/* =====================================================
   STATISTICS
===================================================== */

.stat-number {

    font-size: 29px;

    font-weight: 900;

    letter-spacing: -1px;

}


/* =====================================================
   BADGES
===================================================== */

.badge {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    border-radius: 999px;

    padding: 6px 10px;

    font-size: 9px;

    font-weight: 900;

    text-transform: uppercase;

    letter-spacing: .05em;

}

.badge-low {

    background: #ecfdf5;
    color: #047857;

}

.badge-medium {

    background: #fffbeb;
    color: #b45309;

}

.badge-high {

    background: #fff7ed;
    color: #c2410c;

}

.badge-critical {

    background: #fff1f2;
    color: #be123c;

}


/* =====================================================
   MODAL
===================================================== */

.modal-bg {

    position: fixed;

    inset: 0;

    background: rgba(15,23,42,.52);

    backdrop-filter: blur(5px);

    z-index: 100;

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

}

.modal {

    width: 100%;

    max-width: 600px;

    background: white;

    border-radius: 24px;

    box-shadow:
        0 30px 80px rgba(15,23,42,.2);

    animation: modalIn .25s ease;

}

@keyframes modalIn {

    from {

        opacity: 0;

        transform:
            translateY(15px)
            scale(.98);

    }

    to {

        opacity: 1;

        transform:
            translateY(0)
            scale(1);

    }

}


/* =====================================================
   TABLE
===================================================== */

.patient-row {

    transition: .18s;

    cursor: pointer;

}

.patient-row:hover {

    background: #f8fafc;

}


/* =====================================================
   AVATAR
===================================================== */

.avatar {

    width: 42px;
    height: 42px;

    border-radius: 13px;

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 13px;

    font-weight: 900;

}


/* =====================================================
   AI
===================================================== */

.ai-shell {

    background:

        radial-gradient(
            circle at 80% 10%,
            rgba(37,99,235,.10),
            transparent 30%
        ),

        white;

}

.chat-messages {

    height: 430px;

    overflow-y: auto;

    padding: 20px;

}

.chat-user {

    background: #2563eb;

    color: white;

    border-radius:
        18px
        18px
        4px
        18px;

    max-width: 80%;

    padding: 12px 15px;

    margin-left: auto;

    font-size: 13px;

    line-height: 1.6;

}

.chat-ai {

    background: #f1f5f9;

    color: #334155;

    border-radius:
        18px
        18px
        18px
        4px;

    max-width: 85%;

    padding: 12px 15px;

    font-size: 13px;

    line-height: 1.6;

}

.ai-dot {

    width: 8px;
    height: 8px;

    background: #2563eb;

    border-radius: 50%;

    animation: pulseAI 1.2s infinite;

}

@keyframes pulseAI {

    0%,100% {
        opacity: .25;
    }

    50% {
        opacity: 1;
    }

}


/* =====================================================
   FILE / EXPEDIENTE
===================================================== */

.file-card {

    transition: .2s;

    cursor: pointer;

}

.file-card:hover {

    transform: translateY(-2px);

    border-color: #bfdbfe;

}


/* =====================================================
   TIMELINE
===================================================== */

.timeline {

    position: relative;

}

.timeline::before {

    content: "";

    position: absolute;

    left: 17px;

    top: 0;

    bottom: 0;

    width: 2px;

    background: #e2e8f0;

}

.timeline-item {

    position: relative;

    padding-left: 48px;

    padding-bottom: 28px;

}

.timeline-dot {

    position: absolute;

    left: 9px;

    top: 2px;

    width: 18px;

    height: 18px;

    border-radius: 50%;

    background: white;

    border: 4px solid #2563eb;

}


/* =====================================================
   ANALYZER SOON
===================================================== */

.soon-card {

    min-height: 530px;

    background:

        radial-gradient(
            circle at 50% 20%,
            rgba(37,99,235,.08),
            transparent 35%
        ),

        white;

}

.lock-circle {

    width: 85px;

    height: 85px;

    border-radius: 25px;

    background: #eff6ff;

    color: #2563eb;

    display: flex;

    align-items: center;
    justify-content: center;

}


/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:900px) {

    .sidebar {

        width: 72px;

    }

    .hide-mobile {

        display: none !important;

    }

    .nav-item {

        justify-content: center;

    }

    .main {

        margin-left: 72px;

    }

}

@media(max-width:640px) {

    .sidebar {

        display: none;

    }

    .main {

        margin-left: 0;

    }

}

</style>
</head>



<script>

/* =====================================================
   DEMO DATA
===================================================== */

const defaultPatients = [

    {
        id: 1,
        name: "Laura Martínez",
        document: "1020304050",
        age: 21,
        risk: "Medio",
        status: "Seguimiento",
        date: "02 Oct 2026"
    },

    {
        id: 2,
        name: "Daniel Rodríguez",
        document: "1030405060",
        age: 24,
        risk: "Bajo",
        status: "Estable",
        date: "30 Sep 2026"
    },

    {
        id: 3,
        name: "Sofía Hernández",
        document: "1010203040",
        age: 19,
        risk: "Alto",
        status: "Prioritario",
        date: "29 Sep 2026"
    },

    {
        id: 4,
        name: "Mateo Vargas",
        document: "1002030405",
        age: 27,
        risk: "Bajo",
        status: "Estable",
        date: "27 Sep 2026"
    },

    {
        id: 5,
        name: "Camila Torres",
        document: "1004050607",
        age: 22,
        risk: "Crítico",
        status: "Revisión inmediata",
        date: "25 Sep 2026"
    }

];


let patients =
    JSON.parse(
        localStorage.getItem("saders_patients")
    ) || defaultPatients;


/* =====================================================
   LOGIN
===================================================== */

function login(event) {

    event.preventDefault();

    const user =
        document
            .getElementById("loginUser")
            .value
            .trim();

    const pass =
        document
            .getElementById("loginPass")
            .value
            .trim();


    if (!user || !pass)
        return;


    localStorage.setItem(
        "saders_user",
        user
    );


    /* Activamos inmediatamente la sesión */
    document.documentElement.classList.add(
        "saders-session"
    );


    document
        .getElementById("loginScreen")
        .style.display = "none";


    document
        .getElementById("app")
        .style.display = "block";


    initializeApp();

}


/* =====================================================
   LOGOUT
===================================================== */

function logout() {

    localStorage.removeItem(
        "saders_user"
    );


    /* Quitamos la sesión del documento */
    document.documentElement.classList.remove(
        "saders-session"
    );


    document
        .getElementById("app")
        .style.display = "none";


    document
        .getElementById("loginScreen")
        .style.display = "flex";


    /* Limpiamos campos del login */
    const userInput =
        document.getElementById("loginUser");

    const passInput =
        document.getElementById("loginPass");

    if (userInput)
        userInput.value = "";

    if (passInput)
        passInput.value = "";

}


/* =====================================================
   INITIALIZE
===================================================== */

function initializeApp() {

    const user =
        localStorage.getItem(
            "saders_user"
        ) || "Profesional";


    const displayName =
        user
            .replace(/[._-]/g," ")
            .replace(
                /\b\w/g,
                l => l.toUpperCase()
            );


    document
        .getElementById("welcomeUser")
        .textContent = displayName;


    document
        .getElementById("sideUser")
        .textContent = displayName;


    document
        .getElementById("topAvatar")
        .textContent =
        displayName
            .charAt(0)
            .toUpperCase();


    updateStats();

    renderPatients();

    renderRecent();

    renderRecords();

    renderPriority();

}


/* =====================================================
   NAVIGATION
===================================================== */

function showPage(page,button) {

    document
        .querySelectorAll(".page")
        .forEach(
            el =>
                el.classList.add("hidden")
        );


    const target =
        document.getElementById(
            "page-" + page
        );


    if (target)
        target.classList.remove("hidden");


    document
        .querySelectorAll(".nav-item")
        .forEach(
            el =>
                el.classList.remove("active")
        );


    if (button)
        button.classList.add("active");


    const titles = {

        dashboard: "Centro de control",

        patients: "Pacientes",

        records: "Expedientes",

        ai: "SADERS IA",

        analyzer: "Analizador"

    };


    document
        .getElementById("pageTitle")
        .textContent =
        titles[page] || "SADERS";


    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

}


function showPageByName(page) {

    const buttons =
        document.querySelectorAll(
            ".nav-item"
        );


    let target = null;


    buttons.forEach(btn => {

        const click =
            btn.getAttribute(
                "onclick"
            ) || "";


        if (
            click.includes(
                "'" + page + "'"
            )
        ) {

            target = btn;

        }

    });


    showPage(page,target);

}


/* =====================================================
   STATS
===================================================== */

function updateStats() {

    const total =
        patients.length;


    const medium =
        patients.filter(
            p => p.risk === "Medio"
        ).length;


    const high =
        patients.filter(
            p =>
                p.risk === "Alto" ||
                p.risk === "Crítico"
        ).length;


    document
        .getElementById("statTotal")
        .textContent = total;


    document
        .getElementById("statMedium")
        .textContent = medium;


    document
        .getElementById("statHigh")
        .textContent = high;


    document
        .getElementById("statRecords")
        .textContent = total;

}


/* =====================================================
   PATIENT HELPERS
===================================================== */

function getInitials(name) {

    return name
        .split(" ")
        .slice(0,2)
        .map(
            x =>
                x.charAt(0)
        )
        .join("")
        .toUpperCase();

}


function avatarColor(risk) {

    if (risk === "Crítico")
        return "bg-red-50 text-red-600";

    if (risk === "Alto")
        return "bg-orange-50 text-orange-600";

    if (risk === "Medio")
        return "bg-amber-50 text-amber-600";

    return "bg-blue-50 text-blue-600";

}


function riskBadge(risk) {

    let cls =
        "badge-low";


    if (risk === "Medio")
        cls = "badge-medium";


    if (risk === "Alto")
        cls = "badge-high";


    if (risk === "Crítico")
        cls = "badge-critical";


    return `

        <span class="badge ${cls}">

            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>

            ${escapeHTML(risk)}

        </span>

    `;

}


/* =====================================================
   PRIORITY
===================================================== */

function renderPriority() {

    const container =
        document.getElementById(
            "priorityPatients"
        );


    const priority =
        patients
            .filter(
                p =>
                    p.risk === "Alto" ||
                    p.risk === "Crítico"
            )
            .slice(0,4);


    if (!priority.length) {

        container.innerHTML = `

            <div class="text-center py-10 text-sm text-slate-400">

                No hay pacientes prioritarios.

            </div>

        `;

        return;

    }


    container.innerHTML =
        priority
            .map(
                patient => `


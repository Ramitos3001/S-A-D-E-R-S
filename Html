/* =====================================================
   AI CHAT
===================================================== */

function handleChatKey(event) {

    if (
        event.key === "Enter" &&
        !event.shiftKey
    ) {

        event.preventDefault();

        sendMessage();

    }

}


function addChatMessage(
    text,
    type
) {

    const container =
        document.getElementById(
            "chatMessages"
        );


    const message =
        document.createElement(
            "div"
        );


    message.className =
        type === "user"
            ? "chat-user mb-4"
            : "chat-ai mb-4";


    message.innerHTML =
        escapeHTML(text)
            .replace(
                /\n/g,
                "<br>"
            );


    container.appendChild(
        message
    );


    container.scrollTop =
        container.scrollHeight;

}


async function sendMessage() {

    const input =
        document.getElementById(
            "chatInput"
        );


    const text =
        input.value.trim();


    if (!text)
        return;


    addChatMessage(
        text,
        "user"
    );


    input.value = "";


    const loading =
        document.createElement(
            "div"
        );


    loading.className =
        "chat-ai mb-4";


    loading.innerHTML = `

        <div class="flex items-center gap-2">

            <span class="ai-dot"></span>

            <span class="ai-dot" style="animation-delay:.2s"></span>

            <span class="ai-dot" style="animation-delay:.4s"></span>

            <span class="text-xs text-slate-400 ml-1">
                SADERS IA está pensando...
            </span>

        </div>

    `;


    const container =
        document.getElementById(
            "chatMessages"
        );


    container.appendChild(
        loading
    );


    container.scrollTop =
        container.scrollHeight;


    try {

        /*
        ====================================================
        API

        TU BACKEND DEBE EXPONER:

        POST /api/chat

        BODY:

        {
            "message": "texto del usuario"
        }

        RESPUESTA:

        {
            "reply": "respuesta del bot"
        }

        IMPORTANTE:
        NO pongas tu API KEY aquí.
        La API KEY debe vivir en tu backend.
        ====================================================
        */


        const response =
            await fetch(
                "/api/chat",
                {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            message: text
                        })

                }
            );


        if (!response.ok)
            throw new Error(
                "API unavailable"
            );


        const data =
            await response.json();


        loading.remove();


        addChatMessage(
            data.reply ||
            "La API no devolvió una respuesta.",
            "ai"
        );


    } catch(error) {

        loading.remove();


        let reply =
            "Modo demostración activo. ";


        if (
            text
                .toLowerCase()
                .includes("paciente")
        ) {

            reply +=
                "Puedes consultar los pacientes desde el módulo Pacientes y revisar su historial desde Expedientes.";

        }

        else if (
            text
                .toLowerCase()
                .includes("expediente")
        ) {

            reply +=
                "El módulo Expedientes permite visualizar información, seguimiento y actividad registrada.";

        }

        else {

            reply +=
                "Cuando conectes tu backend en /api/chat, este módulo podrá utilizar el modelo de IA que tú elijas.";

        }


        addChatMessage(
            reply,
            "ai"
        );

    }

}



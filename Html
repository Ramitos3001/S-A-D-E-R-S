function addPatient(event) {

    event.preventDefault();


    const name =
        document
            .getElementById(
                "patientName"
            )
            .value
            .trim();


    const documentId =
        document
            .getElementById(
                "patientDocument"
            )
            .value
            .trim();


    const age =
        document
            .getElementById(
                "patientAge"
            )
            .value;


    const risk =
        document
            .getElementById(
                "patientRisk"
            )
            .value;


    let status =
        "Estable";


    if (risk === "Medio")
        status = "Seguimiento";


    if (risk === "Alto")
        status = "Prioritario";


    if (risk === "Crítico")
        status =
            "Revisión inmediata";


    const newPatient = {

        id: Date.now(),

        name,

        document: documentId,

        age: Number(age),

        risk,

        status,

        date:
            new Date()
                .toLocaleDateString(
                    "es-CO",
                    {
                        day:"2-digit",
                        month:"short",
                        year:"numeric"
                    }
                )

    };


    patients.unshift(
        newPatient
    );


    savePatients();


    document
        .querySelector(
            "#patientModal form"
        )
        .reset();


    closePatientModal();


    updateStats();

    renderPatients();

    renderPriority();

    renderRecords();

    showPageByName(
        "patients"
    );

}


